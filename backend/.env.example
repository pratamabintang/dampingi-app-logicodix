# Server
APP_ENV=development
PORT=8000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini (dipakai chatbot C dan ringkasan mingguan D)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# AI chatbot
# fake = jawaban palsu tanpa biaya (default)
# gemini = panggil Gemini sungguhan (butuh GEMINI_API_KEY + GEMINI_MODEL)
# openai_compatible = gateway/penyedia pihak ketiga yang protokolnya OpenAI
#                     (butuh AI_API_KEY + AI_BASE_URL + AI_MODEL, mis. base https://host/v1)
AI_PROVIDER=fake
AI_TIMEOUT_SECONDS=20
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

TRUSTED_HOSTS=