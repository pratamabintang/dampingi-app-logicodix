# Server
APP_ENV=development
PORT=8000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini (dipakai chatbot C dan ringkasan mingguan D)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# AI chatbot
# fake = jawaban palsu tanpa biaya (default); gemini = panggil Gemini sungguhan
AI_PROVIDER=fake
AI_TIMEOUT_SECONDS=20

TRUSTED_HOSTS=